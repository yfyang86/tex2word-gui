# Local config with real secrets (commit config.sample.toml instead)
config.toml

# server.sh runtime artifacts
.server.pid
server.log

# platform/macos/arm/build_dmg.sh tee output
build.log

# default SQLite project store (metasqlite_db); tests use a temp DB
tex2word.db
*.db

# auth signing keys (generated by manage.py init-keys — never commit)
*.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.python-version

# uv / venv
.venv/
# local dev lock; CI and Docker resolve from pyproject.toml (uv pip install)
uv.lock

# tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# build artifacts
*.docx
!tests/**/*.docx


# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# embedded TikZ editor: built by scripts/build_tikz_editor.sh, not committed
.cache/
app/static/vendor/tikz-editor/

# master key for secrets stored in the DB (provider API keys) — never commit
tex2word_secret.key
